# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/cyber_cafe for local)
MONGO_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/cyber_cafe?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-characters
# Customer sessions (D7). Staff/owner sessions use ADMIN_JWT_EXPIRES_IN.
JWT_EXPIRES_IN=3d
ADMIN_JWT_EXPIRES_IN=12h

# First owner account (created automatically on first start, or by `npm run seed`).
# Use a strong password (10+ characters, letters and numbers). A live server refuses to start with ChangeMe@123.
ADMIN_NAME=Cafe Owner
ADMIN_EMAIL=owner@cybercafe.local
ADMIN_PASSWORD=ChangeMe@123

# Razorpay - leave both empty to use TEST payments in development.
# In production (NODE_ENV=production) all three are required, or the server will not start (B1, B2).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional) - leave SMTP_HOST empty to print emails in the console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cyber Cafe <no-reply@example.com>"

# SMS / OTP provider - empty means OTPs and SMS print in the console (development)
# Options: fast2sms | msg91 | twilio   (in production the OTP is never shown on screen)
SMS_PROVIDER=
# Fast2SMS: OTP uses the built-in OTP route. For status SMS on the DLT route add sender + template id.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
# MSG91: Flow templates. OTP template uses variable ##otp##, status template uses ##message##
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Files - in production point UPLOAD_DIR at a persistent disk (e.g. /var/data/uploads on a Render disk)
UPLOAD_DIR=uploads
MAX_FILE_MB=10

# Encryption key for uploaded documents and backups (C3, C2): 64 hex characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. In development a key is created in backend/.file-key.
# Keep a copy somewhere safe: without it, stored documents and backups cannot be opened.
FILE_ENCRYPTION_KEY=

# Abuse limits (D1, D2, B4)
OTP_PER_HOUR=5
MAX_UNPAID_ORDERS=5
MAX_UNPAID_PRINTS=5
MAX_OPEN_FREE_ORDERS=2

# Unpaid orders: their uploaded documents are deleted after this many days
DRAFT_DAYS=3

# Daily backup of the database (set to "off" to disable, e.g. when MongoDB Atlas backups are on)
BACKUP_DIR=backups
BACKUP_KEEP=14

# Shown on PDF receipts
CAFE_NAME="Cyber Cafe"
CAFE_ADDRESS=
CAFE_PHONE=
CAFE_EMAIL=
CAFE_GSTIN=
